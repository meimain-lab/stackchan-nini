----------------------------------------------------------------------
-- One "z" glyph: two bars and a diagonal band (aora sleep signature).
----------------------------------------------------------------------
fn draw_z(x, y, s, color)
  let th = clamp(s * 0.24, 1, 99)
  fill_rect(x, y, s, th, color)
  fill_rect(x, y + s - th, s, th, color)
  fill_triangle(x + s - th, y + th, x + s, y + th, x, y + s - th, color)
  fill_triangle(x + s, y + th, x + th, y + s - th, x, y + s - th, color)
end

----------------------------------------------------------------------
-- One heart: two lobes and a point. Floats up while being petted.
----------------------------------------------------------------------
fn draw_heart(x, y, s, color)
  fill_circle(x - s * 0.5, y - s * 0.35, s * 0.55, color)
  fill_circle(x + s * 0.5, y - s * 0.35, s * 0.55, color)
  fill_triangle(x - s * 1.02, y - s * 0.1, x + s * 1.02, y - s * 0.1, x, y + s * 1.1, color)
end

----------------------------------------------------------------------
-- Axis-aligned ellipse via scanlines. Used for speech squash so the
-- resting circle does not become a polygon the moment the mouth opens.
----------------------------------------------------------------------
fn fill_ellipse(cx, cy, rx, ry, color)
  let y = -ry
  while y <= ry do
    let ny = y / ry
    let inside = 1 - ny * ny
    if inside > 0 then
      let hw = rx * sqrt(inside)
      fill_rect(cx - hw, cy + y, hw * 2 + 1, 1, color)
    end
    y = y + 1
  end
end

----------------------------------------------------------------------
-- Listening ripple: 16 dots on a circle of radius r (dot radius d). The DSL
-- has no trig, so the unit vectors are spelled out; small dots cost far less
-- than filling and clearing a large ring every frame.
----------------------------------------------------------------------
fn arc_seg(cx, cy, r0, r1, c0, s0, c1, s1, color)
  fill_triangle(cx + r0 * c0, cy + r0 * s0, cx + r1 * c0, cy + r1 * s0, cx + r0 * c1, cy + r0 * s1, color)
  fill_triangle(cx + r1 * c0, cy + r1 * s0, cx + r0 * c1, cy + r0 * s1, cx + r1 * c1, cy + r1 * s1, color)
end

-- One ")" sound-wave arc spanning -36..36 degrees; side = 1 right, -1 left.
fn sound_arc(cx, cy, r, th, side, color)
  let r1 = r + th
  arc_seg(cx, cy, r, r1, side * 0.809, -0.588, side * 0.891, -0.454, color)
  arc_seg(cx, cy, r, r1, side * 0.891, -0.454, side * 0.951, -0.309, color)
  arc_seg(cx, cy, r, r1, side * 0.951, -0.309, side * 0.988, -0.156, color)
  arc_seg(cx, cy, r, r1, side * 0.988, -0.156, side * 1.0, 0, color)
  arc_seg(cx, cy, r, r1, side * 1.0, 0, side * 0.988, 0.156, color)
  arc_seg(cx, cy, r, r1, side * 0.988, 0.156, side * 0.951, 0.309, color)
  arc_seg(cx, cy, r, r1, side * 0.951, 0.309, side * 0.891, 0.454, color)
  arc_seg(cx, cy, r, r1, side * 0.891, 0.454, side * 0.809, 0.588, color)
end

----------------------------------------------------------------------
-- Entry point. RGB565, white face on a black background:
--   0x0000 = black background, 0xFFFF = white body, 0x0000 = black eyes.
-- Eye geometry/motion lives in C++ (aora rings); this draws body + eyes.
----------------------------------------------------------------------

----------------------------------------------------------------------
-- Voice-error glyphs (ElevenLabs unreachable).
----------------------------------------------------------------------
fn thick_line(x0, y0, x1, y1, th, color)
  let dx = x1 - x0
  let dy = y1 - y0
  let len = sqrt(dx * dx + dy * dy)
  let nx = 0 - dy / len * th / 2
  let ny = dx / len * th / 2
  fill_triangle(x0 + nx, y0 + ny, x1 + nx, y1 + ny, x0 - nx, y0 - ny, color)
  fill_triangle(x1 + nx, y1 + ny, x1 - nx, y1 - ny, x0 - nx, y0 - ny, color)
end

fn draw_x(x, y, s, th, color)
  thick_line(x - s, y - s, x + s, y + s, th, color)
  thick_line(x - s, y + s, x + s, y - s, th, color)
end

fn draw_bang(x, y, s, color)
  fill_circle(x, y, s * 1.25, color)
  fill_rect(x - s * 0.17, y - s * 0.8, s * 0.34, s * 1.0, 0xFFFF)
  fill_circle(x, y + s * 0.6, s * 0.19, 0xFFFF)
end

fn draw_muted_speaker(x, y, s, color)
  fill_rect(x - s, y - s * 0.4, s * 0.6, s * 0.8, 0xFFFF)
  fill_triangle(x - s * 0.4, y - s * 0.4, x + s * 0.3, y - s, x + s * 0.3, y + s, 0xFFFF)
  fill_triangle(x - s * 0.4, y - s * 0.4, x - s * 0.4, y + s * 0.4, x + s * 0.3, y + s, 0xFFFF)
  thick_line(x - s * 1.2, y - s * 1.1, x + s * 1.0, y + s * 1.1, s * 0.3, color)
end

fn draw()
  let paper = 0x0000
  let body = 0xFFFF
  let eyes = 0x0000

  let talk = clamp(mouth_open, 0, 1)
  let sx = 1 + talk * 0.04
  let sy = 1 - talk * 0.14

  -- Aora-style life: joy states hop, angry trembles, everyone breathes.
  let hop = 0
  if expr == HAPPY then
    let hp = (now_ms / 35) % 40
    if hp > 20 then
      hp = 40 - hp
    end
    hop = 0 - hp / 20 * sz(2.6)
  elif expr == EXCITED then
    let he = (now_ms / 26) % 40
    if he > 20 then
      he = 40 - he
    end
    hop = 0 - he / 20 * sz(2)
  end
  let bx = 0
  if expr == ANGRY then
    bx = (floor(now_ms / 70) % 2 * 2 - 1) * sz(1.1)
  end
  let breath_step = 85
  let breath_amp = 0.012
  if expr == SLEEPY then
    breath_step = 115
    breath_amp = 0.018
  end
  let bre = (now_ms / breath_step) % 40
  if bre > 20 then
    bre = 40 - bre
  end
  let breath = 1 + (bre - 10) / 10 * breath_amp

  fill_rect(0, 0, canvas_w, canvas_h, paper)
  begin_group(0, 0, canvas_w, canvas_h)

  let cx = tx(160) + bx
  let cy = ty(120) + hop
  let b = clamp(expr_blend, 0, 1)
  let hb = clamp(expr_hold_blend, 0, 1)
  let hb2 = clamp(expr_hold2_blend, 0, 1)
  let body_scale_mix = 0
  let mix_i = 0
  while mix_i < 4 do
    let e = expr_from
    let w = (1 - hb2) * (1 - hb) * (1 - b)
    if mix_i == 1 then
      e = expr_hold2_to
      w = hb2 * (1 - hb) * (1 - b)
    elif mix_i == 2 then
      e = expr_hold_to
      w = hb * (1 - b)
    elif mix_i == 3 then
      e = expr
      w = b
    end
    let s = 1
    if e == EXCITED then
      s = 1.06
    elif e == SURPRISED then
      s = 1.05
    elif e == HAPPY then
      s = 1.03
    elif e == LISTENING then
      s = 1.01
    elif e == CURIOUS then
      s = 1.02
    elif e == CONFUSED then
      s = 0.995
    elif e == SLEEPY then
      s = 0.97
    elif e == SAD then
      s = 0.98
    elif e == THINKING then
      s = 0.99
    elif e == DIZZY then
      s = 1.02
    elif e == AFFECTION then
      s = 1.01
    elif e == BORED then
      s = 0.985
    end
    body_scale_mix = body_scale_mix + s * w
    mix_i = mix_i + 1
  end
  let base_r = sz(100) * body_scale_mix * breath

  -- Listening: thin cyan rim that breathes while waiting and thickens with
  -- the user's voice; the body swells slightly as if taking the sound in.
  let lw = 0
  let lv = 0
  if expr == LISTENING then
    lw = b
    lv = clamp(voice_level, 0, 1)
    base_r = base_r * (1 + lv * 0.03 * lw)
    let rb = (now_ms / 40) % 40
    if rb > 20 then
      rb = 40 - rb
    end
    fill_circle(cx, cy, base_r + (sz(2) + rb / 20 * sz(1.5) + lv * sz(6)) * lw, 0x07FF)
  end

  if expr == DIZZY then
    body = 0xF800
  end
  if talk > 0.05 then
    fill_ellipse(cx, cy, base_r * sx, base_r * sy, body)
  else
    fill_circle(cx, cy, base_r, body)
  end

  -- Sleeping zzz trail floating up past the top-right edge (aora emotion 00 睡眠, "sleep").
  if expr == SLEEPY then
    let zi = 0
    while zi < 3 do
      let zc = ((now_ms + zi * 900) / 70) % 40
      let zr = zc / 40 * sz(12)
      let zx = tx(244 + zi * 14)
      let zy = ty(58 - zi * 16) - zr
      let zs = sz(7 + zi * 2)
      draw_z(zx, zy, zs, body)
      zi = zi + 1
    end
  end

  -- Petting = aora emotion 14 害羞 ("shy"): blush riding just below each eye. The eyes dart
  -- around while shy (look-away sweep + ring pool swaps), so the blush
  -- centres are sampled live from the ring coordinates (4-point centroid)
  -- instead of fixed positions. Plus a little heart floating up beside the
  -- head.
  if expr == AFFECTION then
    if b > 0.6 then
      let blx = (ring_l0x + ring_l12x + ring_l24x + ring_l36x) / 4
      let bly = (ring_l0y + ring_l12y + ring_l24y + ring_l36y) / 4
      let brx = (ring_r0x + ring_r12x + ring_r24x + ring_r36x) / 4
      let bry = (ring_r0y + ring_r12y + ring_r24y + ring_r36y) / 4
      fill_ellipse(blx, bly + sz(24), sz(11), sz(6), 0xFD15)
      fill_ellipse(brx, bry + sz(24), sz(11), sz(6), 0xFD15)
      let hc = (now_ms / 60) % 40
      let hyy = ty(52) - hc / 40 * sz(16)
      draw_heart(tx(243), hyy, sz(6 + 2 * (hc / 40)), body)
    end
  end

  -- Listening ears: ")))" sound-wave arcs on both sides, in the strips of
  -- screen the body leaves free. Silent: only the inner arc, dim. Speaking:
  -- arcs light up from the inside out with loudness and drift outwards.
  if lw > 0.3 then
    let drift = ((now_ms % 500) / 500) * sz(4) * lv
    let ak = 0
    while ak < 3 do
      let lit = clamp((lv - ak * 0.25) / 0.2, 0, 1)
      let col = 0
      if lit > 0.6 then
        col = 0x07FF
      elif lit > 0.05 then
        col = 0x05F7
      elif ak == 0 then
        col = 0x03EF
      end
      if col > 0 then
        let ar = base_r + sz(14) + ak * sz(15) + drift
        sound_arc(cx, cy, ar, sz(4), 1, col)
        sound_arc(cx, cy, ar, sz(4), -1, col)
      end
      ak = ak + 1
    end
  end

  if expr == DIZZY then
    let exl = (ring_l0x + ring_l12x + ring_l24x + ring_l36x) / 4
    let eyl = (ring_l0y + ring_l12y + ring_l24y + ring_l36y) / 4
    let exr = (ring_r0x + ring_r12x + ring_r24x + ring_r36x) / 4
    let eyr = (ring_r0y + ring_r12y + ring_r24y + ring_r36y) / 4
    draw_x(exl, eyl, sz(13), sz(7), eyes)
    draw_x(exr, eyr, sz(13), sz(7), eyes)
  else
    ring_eyes(eyes)
  end
  end_group()
end
