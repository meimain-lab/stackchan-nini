--
-- Grok bot face, aora edition. Eye shapes are the aora-bot
-- (github.com/sam70361/aora-bot) emotion-ball eye rings: 48-point outlines
-- interpolated per frame in C++ (main/aora_face.hpp: ring pool rotation,
-- four-way expression mixing, aora anims, blink/wink/openness squash) and
-- handed to the VM via the Var::RingBase window as final screen coordinates.
-- The DSL draws them as a fixed 46-triangle strip per eye and keeps the body
-- layer: perfect white circle on black, breathing, joy hop, speech squash,
-- sleeping zzz, petting heart. Body shape never morphs.

----------------------------------------------------------------------
-- Both eyes as triangle strips over the ring coordinate variables.
----------------------------------------------------------------------
fn ring_eyes(color)
  fill_triangle(ring_l0x, ring_l0y, ring_l1x, ring_l1y, ring_l47x, ring_l47y, color)
  fill_triangle(ring_l1x, ring_l1y, ring_l47x, ring_l47y, ring_l2x, ring_l2y, color)
  fill_triangle(ring_l47x, ring_l47y, ring_l2x, ring_l2y, ring_l46x, ring_l46y, color)
  fill_triangle(ring_l2x, ring_l2y, ring_l46x, ring_l46y, ring_l3x, ring_l3y, color)
  fill_triangle(ring_l46x, ring_l46y, ring_l3x, ring_l3y, ring_l45x, ring_l45y, color)
  fill_triangle(ring_l3x, ring_l3y, ring_l45x, ring_l45y, ring_l4x, ring_l4y, color)
  fill_triangle(ring_l45x, ring_l45y, ring_l4x, ring_l4y, ring_l44x, ring_l44y, color)
  fill_triangle(ring_l4x, ring_l4y, ring_l44x, ring_l44y, ring_l5x, ring_l5y, color)
  fill_triangle(ring_l44x, ring_l44y, ring_l5x, ring_l5y, ring_l43x, ring_l43y, color)
  fill_triangle(ring_l5x, ring_l5y, ring_l43x, ring_l43y, ring_l6x, ring_l6y, color)
  fill_triangle(ring_l43x, ring_l43y, ring_l6x, ring_l6y, ring_l42x, ring_l42y, color)
